# Copy to .env (or put these in the systemd unit) and adjust.

# Local port; the hub only ever listens on 127.0.0.1, behind the reverse proxy.
HUB_PORT=8795
# GitHub organisation whose active members may sign in.
HUB_ORG=ForestAdmin
# Client ID of the GitHub OAuth app (device flow enabled, no client secret). Not a secret.
HUB_GITHUB_CLIENT_ID=
# File holding a classic token with the read:org scope only, used to check membership.
# Default: ~/.config/radar-hub/github-token
HUB_GITHUB_TOKEN_FILE=
# Where hub.json and the admin socket live. Default: data/ next to the binary.
HUB_DATA_DIR=
